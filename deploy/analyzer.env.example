# Copy to analyzer.env next to your docker-compose.yaml. Keeps secrets out of the compose file.
# Only put things here that are secret or channel-specific; the rest live in the compose service.

# VirusTotal (free public API: 4/min, 500/day, 15.5K/month). Personal, non-commercial use only.
VT_API_KEY=

# Optional extra reputation sources (quota-aware, same scheduler as VirusTotal).
#ABUSEIPDB_KEY=
#GREYNOISE_KEY=

# Optional: use local MaxMind GeoLite2 instead of ip-api.com (mount the .mmdb files into the
# container and point at them). pfBlockerNG on pfSense already downloads these.
#GEOIP_CITY_DB=/geoip/GeoLite2-City.mmdb
#GEOIP_ASN_DB=/geoip/GeoLite2-ASN.mmdb

# Notifications — configure ONE (or more). Alerts >= NOTIFY_MIN_SEVERITY are delivered.
#NOTIFY_NTFY_URL=https://ntfy.sh/your-secret-topic
#NOTIFY_NTFY_TOKEN=
#NOTIFY_TELEGRAM_TOKEN=
#NOTIFY_TELEGRAM_CHAT_ID=
#NOTIFY_SLACK_WEBHOOK_URL=
#NOTIFY_GOTIFY_URL=
#NOTIFY_GOTIFY_TOKEN=
#NOTIFY_WEBHOOK_URL=
#NOTIFY_SMTP_HOST=
#NOTIFY_SMTP_PORT=587
#NOTIFY_SMTP_USER=
#NOTIFY_SMTP_PASS=
#NOTIFY_SMTP_FROM=analyzer@example.com
#NOTIFY_SMTP_TO=you@example.com
#NOTIFY_QUIET_HOURS=23-7
#NOTIFY_DIGEST=0
